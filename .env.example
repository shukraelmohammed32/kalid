# Use the pooled URL for the running website.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: use the direct URL for the one-time db:setup command.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
PORT=3000

# Required for /admin.html. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-admin-password
# Required to sign admin sessions. Generate a separate random value.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Public Vercel URL(s), comma-separated, allowed to call the Render API.
# Example: https://your-project.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=https://kalid-lo4p.vercel.app
FRONTEND_ORIGIN=https://kalid-lo4p.vercel.app
# Browser API base URL used by the Vercel static frontend.
KALID_API_URL=https://kalid-6r8l.onrender.com
